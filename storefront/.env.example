# Kiosna storefront configuration. For local preview, copy to `.env.local` and
# fill in real values. In production, set these as Kodena script vars.
# Required:
API_BASE_URL=https://api.sawala.cloud
NEXT_PUBLIC_STOREFRONT_SLUG=your-storefront-slug
# A PUBLISHABLE key (pk_…). NEVER a secret sk_ key.
KIOSNA_PUBLISHABLE_KEY=pk_live_REPLACE_ME
# Branding:
NEXT_PUBLIC_SITE_NAME=Your Shop
NEXT_PUBLIC_CURRENCY=IDR
# Optional — use the consumer-host plane (shop served on its own hostname; no key):
# API_USE_HOST_PLANE=true
