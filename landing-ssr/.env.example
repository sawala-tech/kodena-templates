# Build-time env required by the Landing template.
# In production the Kodena sites-builder injects these into the container.
# For local preview, copy to `.env.local` and fill in real values.

KONTENA_BASE_URL=https://api.sawala.cloud/public/kontena
KONTENA_PROJECT_ID=proj_REPLACE_ME
NEXT_PUBLIC_KONTENA_API_KEY=pk_live_REPLACE_ME
DEFAULT_LOCALE=id
LOCALES=id,en
SITE_NAME=My Landing
SITE_ORIGIN=http://localhost:3000
NEXT_PUBLIC_FORMULIR_API_KEY=
NEXT_PUBLIC_FORMULIR_CONTACT_FORM_SLUG=
